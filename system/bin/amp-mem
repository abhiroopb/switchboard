#!/usr/bin/env bash
# amp-mem — Persistent cross-session memory CLI for Amp
# Inspired by claude-mem. SQLite + FTS5 backed.
#
# Usage:
#   amp-mem init                                    Initialize/migrate database
#   amp-mem save <type> <topic> <summary> [opts]    Save an observation (--private to hide from context/search,
#                                                   --confidence 0..1 to rank below insight rows, --project P)
#   amp-mem search <query> [opts]                   Search memory (compact index, --include-private to show private)
#   amp-mem timeline <id> [--window N]              Chronological context around an observation
#   amp-mem detail <id> [<id2> ...]                 Full observation details
#   amp-mem context [--lines N]                     Output recent context for session priming
#   amp-mem compact [--older-than DAYS]             Compress old entries into summaries
#   amp-mem session-start [--thread-url URL]        Start a new session
#   amp-mem session-end [--session ID] [--summary]  End a session
#   amp-mem stats                                   Memory statistics
#   amp-mem export [--format md|json]               Export all memory
#   amp-mem serve [--port PORT]                     Start web viewer
#   amp-mem migrate                                 Import sessions.jsonl into SQLite
#   amp-mem ingest-thread <id> <title> <summary>    Ingest an Amp thread (de-duped)
#   amp-mem distill-dump [--since DATE]             Dump observations for distillation
#   amp-mem distill-record <n> <notes> <rules>      Record distillation run
#   amp-mem distill-status                          Last distillation info
#   amp-mem backup                                  WAL-safe daily backup (sqlite3 .backup)
#   amp-mem doctor                                  Health checks (pending, FTS, types, size)

set -euo pipefail

# AMP_MEM_DB / AMP_MEM_SCHEMA override the paths (tests, or a machine whose DB lives elsewhere).
DB="${AMP_MEM_DB:-$HOME/.amp/memory/amp-mem.db}"
SCHEMA="${AMP_MEM_SCHEMA:-$HOME/.amp/memory/schema.sql}"

# Observation type allowlist. Anything else is rejected on save and
# flagged by doctor. (Legacy custom types 'metric|...' and 'process|...'
# were coerced to observation/workflow.)
VALID_TYPES_SQL="'observation','decision','discovery','preference','bugfix','config','workflow','people','session','thread','distilled','architecture','pattern','gotcha'"

# ── Helpers ──────────────────────────────────────────────────────────────

_db() {
    sqlite3 -batch "$DB" "$@"
}

# Like _db, but reads SQL from stdin. Use for INSERT/UPDATE statements
# whose interpolated text content (summary, metadata, notes, etc.) could
# exceed the OS arg-length limit (ARG_MAX, ~256KB on macOS, ~2MB on Linux).
_db_stdin() {
    sqlite3 -batch "$DB"
}

_db_json() {
    sqlite3 -json -batch "$DB" "$@"
}

_ensure_db() {
    if [ ! -f "$DB" ]; then
        cmd_init
    fi
}

# distillations table: create it, or migrate the legacy layout in place.
# Older installs made it with run_at, distilled_notes and proposed_rules.
# CREATE TABLE IF NOT EXISTS leaves that table alone, so every MAX(created_at)
# query would fail with "no such column: created_at". The legacy rows are copied over
# (run_at -> created_at, the note and rule text -> summary) and the old table
# is kept as distillations_legacy.
_ensure_distillations() {
    local has_legacy
    has_legacy=$(_db "SELECT COUNT(*) FROM pragma_table_info('distillations') WHERE name='run_at';")
    if [ "$has_legacy" -gt 0 ]; then
        _db_stdin <<'SQL'
BEGIN IMMEDIATE;
ALTER TABLE distillations RENAME TO distillations_legacy;
CREATE TABLE distillations (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    created_at      TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),
    observation_count INTEGER NOT NULL,
    notes_produced  INTEGER NOT NULL DEFAULT 0,
    rules_proposed  INTEGER NOT NULL DEFAULT 0,
    summary         TEXT
);
INSERT INTO distillations (id, created_at, observation_count, summary)
    SELECT id, run_at, observation_count,
           NULLIF(TRIM(COALESCE(distilled_notes, '') || CASE WHEN proposed_rules IS NOT NULL AND proposed_rules <> '' THEN char(10) || 'Rules: ' || proposed_rules ELSE '' END), '')
    FROM distillations_legacy;
COMMIT;
SQL
        echo "✅ Migrated legacy distillations table (old rows kept in distillations_legacy)" >&2
        return 0
    fi
    _db "CREATE TABLE IF NOT EXISTS distillations (
        id              INTEGER PRIMARY KEY AUTOINCREMENT,
        created_at      TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),
        observation_count INTEGER NOT NULL,
        notes_produced  INTEGER NOT NULL DEFAULT 0,
        rules_proposed  INTEGER NOT NULL DEFAULT 0,
        summary         TEXT
    );"
}

_escape() {
    # Escape single quotes for SQL ('' is the SQL-standard escape).
    # NB: the replacement must come from a variable — a literal \'\' here
    # inserts real backslashes into the SQL and breaks any text with an apostrophe.
    local q="''"
    echo "${1//\'/$q}"
}

# Require a numeric ID (observation/session IDs are interpolated into SQL)
_require_int() {
    if ! [[ "$1" =~ ^[0-9]+$ ]]; then
        echo "❌ Expected a numeric ID, got: '$1'" >&2
        exit 1
    fi
}

# Migrate schema: add new columns if they don't exist
_migrate_schema() {
    # Check if confidence column exists
    local has_confidence
    has_confidence=$(_db "SELECT COUNT(*) FROM pragma_table_info('observations') WHERE name='confidence';")
    if [ "$has_confidence" -eq 0 ]; then
        _db "ALTER TABLE observations ADD COLUMN confidence REAL NOT NULL DEFAULT 1.0;"
        _db "ALTER TABLE observations ADD COLUMN access_count INTEGER NOT NULL DEFAULT 0;"
        _db "ALTER TABLE observations ADD COLUMN last_accessed TEXT;"
        echo "✅ Migrated schema: added confidence, access_count, last_accessed columns"
    fi

    local has_private
    has_private=$(_db "SELECT COUNT(*) FROM pragma_table_info('observations') WHERE name='private';")
    if [ "$has_private" -eq 0 ]; then
        _db "ALTER TABLE observations ADD COLUMN private INTEGER NOT NULL DEFAULT 0;"
        echo "✅ Migrated schema: added private column"
    fi

    # compacted_at: per-row compaction marker. Replaces the
    # week-has-a-summary heuristic, which had a dead zone: observations
    # added to a week AFTER its summary existed could never be compacted.
    local has_compacted
    has_compacted=$(_db "SELECT COUNT(*) FROM pragma_table_info('observations') WHERE name='compacted_at';")
    if [ "$has_compacted" -eq 0 ]; then
        _db "ALTER TABLE observations ADD COLUMN compacted_at TEXT;"
        echo "✅ Migrated schema: added compacted_at column"
    fi

    # superseded_by: dedup no longer rewrites history via
    # UPDATE. A newer duplicate is INSERTed and the old row points at it.
    # Superseded rows are hidden from context/search/compact/distill and
    # become prune-eligible (their content lives on in the successor).
    local has_superseded
    has_superseded=$(_db "SELECT COUNT(*) FROM pragma_table_info('observations') WHERE name='superseded_by';")
    if [ "$has_superseded" -eq 0 ]; then
        _db "ALTER TABLE observations ADD COLUMN superseded_by INTEGER REFERENCES observations(id);"
        echo "✅ Migrated schema: added superseded_by column"
    fi

    # summaries.ai_summary: older DBs gained this column by hand; the schema
    # now declares it and this backfills older DBs
    # so `context` never fails on a fresh init.
    local has_ai_summary
    has_ai_summary=$(_db "SELECT COUNT(*) FROM pragma_table_info('summaries') WHERE name='ai_summary';")
    if [ "$has_ai_summary" -eq 0 ]; then
        _db "ALTER TABLE summaries ADD COLUMN ai_summary TEXT;"
        echo "✅ Migrated schema: added summaries.ai_summary column"
    fi

    # injection_log: measurement table for budgeted context
    # injection; created here so the table exists before the first --log.
    _db "CREATE TABLE IF NOT EXISTS injection_log (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
        session_id TEXT, project TEXT, chars INTEGER, row_ids TEXT);"
}

# ── Commands ─────────────────────────────────────────────────────────────

cmd_init() {
    mkdir -p "$(dirname "$DB")"
    if [ -f "$SCHEMA" ]; then
        _db < "$SCHEMA"
        _migrate_schema
        echo "✅ Database initialized at $DB"
    else
        echo "❌ Schema file not found at $SCHEMA" >&2
        exit 1
    fi
}

cmd_save() {
    _ensure_db
    local type="${1:-observation}"
    local topic="${2:?Usage: amp-mem save <type> <topic> <summary> [--project P] [--file F] [--tags T] [--session S]}"
    local summary="${3:?Usage: amp-mem save <type> <topic> <summary>}"
    shift 3

    local project="" file_path="" tags="" session_id="" metadata=""
    local private=0 confidence="1.0"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project)  project="$2"; shift 2 ;;
            --file)     file_path="$2"; shift 2 ;;
            --tags)     tags="$2"; shift 2 ;;
            --session)  session_id="$2"; shift 2 ;;
            --meta)     metadata="$2"; shift 2 ;;
            --confidence) confidence="$2"; shift 2 ;;
            --private)  private=1; shift ;;
            *) shift ;;
        esac
    done

    # Validate --confidence (interpolated into SQL; context ranks by it)
    if ! [[ "$confidence" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]]; then
        echo "❌ --confidence must be a number from 0 to 1, got: '$confidence'" >&2
        exit 1
    fi

    # Validate type against the allowlist (VALID_TYPES_SQL holds quoted names)
    if [[ "$VALID_TYPES_SQL" != *"'$type'"* ]]; then
        echo "❌ Invalid type: '$type'" >&2
        echo "   Valid types: observation decision discovery preference bugfix config workflow people session thread distilled architecture pattern gotcha" >&2
        exit 1
    fi

    # Validate --session is numeric (it is interpolated into SQL)
    if [ -n "$session_id" ] && ! [[ "$session_id" =~ ^[0-9]+$ ]]; then
        echo "❌ --session must be a numeric session ID, got: '$session_id'" >&2
        exit 1
    fi

    local esc_topic; esc_topic=$(_escape "$topic")
    local esc_summary; esc_summary=$(_escape "$summary")
    local esc_project; esc_project=$(_escape "$project")
    local esc_file; esc_file=$(_escape "$file_path")
    local esc_tags; esc_tags=$(_escape "$tags")
    local esc_meta; esc_meta=$(_escape "$metadata")

    local sid="NULL"
    [ -n "$session_id" ] && sid="$session_id"

    # ── Exact repeat within 24 h: same type, topic and 60-char summary
    # prefix, same project and privacy class. The repeat is evidence the
    # memory matters, so bump access_count on the existing row and skip the
    # insert. last_accessed is
    # NOT touched: it records retrieval, and a repeated save is not one.
    # Private rows only match private rows, so no content crosses the
    # privacy line.
    local proj_clause="project IS NULL"
    [ -n "$project" ] && proj_clause="project = '$(_escape "$project")'"
    local repeat_id
    repeat_id=$(_db_stdin <<SQL
SELECT id FROM observations
WHERE type = '$(_escape "$type")'
  AND topic = '$esc_topic'
  AND substr(summary, 1, 60) = substr('$esc_summary', 1, 60)
  AND $proj_clause
  AND private = $private
  AND superseded_by IS NULL
  AND ts >= strftime('%Y-%m-%dT%H:%M:%SZ', 'now', '-1 day')
ORDER BY id DESC LIMIT 1;
SQL
)
    if [ -n "$repeat_id" ]; then
        _db "UPDATE observations SET access_count = access_count + 1 WHERE id = $repeat_id;"
        echo "⏭️ Repeat of observation #$repeat_id within 24h (access bumped): $topic"
        return 0
    fi

    # ── Deduplication: check for similar existing observations ──
    local new_text="$topic $summary"
    local dup_id=""
    local dup_sim="0.0"

    # Search FTS5 for candidates with matching topic words
    local fts_query
    # Replace (not delete) non-alphanumerics so hyphenated words keep their
    # FTS tokens: "amp-mem" → "amp mem" (matches), not "ampmem" (doesn't).
    fts_query=$(echo "$esc_topic" | sed "s/[^a-zA-Z0-9 ]/ /g" | head -c 100)
    # Skip dedup entirely for private saves: superseding would write private
    # content into an existing PUBLIC row (the UPDATE doesn't set private=1),
    # leaking it into context injection. Private saves always insert fresh.
    # Symmetrically, private rows are excluded as candidates below so a
    # public save can never overwrite (and expose) a private row's content.
    if [ "$private" = "1" ]; then
        fts_query=""
    fi
    # Skip dedup if topic is too short for FTS
    if [ ${#fts_query} -gt 3 ]; then
        local candidates
        candidates=$(_db <<DEDUP_SQL
.mode tabs
SELECT o.id, o.topic || ' ' || o.summary AS text
FROM observations_fts f
JOIN observations o ON o.id = f.rowid
WHERE observations_fts MATCH '$fts_query'
AND o.type = '$(_escape "$type")'
AND o.private = 0
AND o.superseded_by IS NULL
ORDER BY rank LIMIT 5;
DEDUP_SQL
        ) 2>/dev/null

    if [ -n "$candidates" ]; then
        # One Python call for all candidates (was: one python + one awk
        # subprocess per candidate — up to 10 processes per save).
        local best
        best=$(printf '%s\n' "$candidates" | python3 -c "
import sys
new = set(sys.argv[1].lower().split())
best_id, best_sim = '', 0.0
for line in sys.stdin:
    parts = line.rstrip('\n').split('\t', 1)
    if len(parts) != 2 or not parts[0]:
        continue
    cand = set(parts[1].lower().split())
    if not new or not cand:
        continue
    sim = len(new & cand) / len(new | cand)
    if sim > best_sim:
        best_id, best_sim = parts[0], sim
if best_sim > 0.6:
    print(f'{best_id} {best_sim:.3f}')
" "$new_text" 2>/dev/null)
        if [ -n "$best" ]; then
            dup_id="${best%% *}"
            dup_sim="${best##* }"
        fi
    fi
    fi  # end fts_query length check

    local id
    if [ -n "$dup_id" ]; then
        # Supersede WITHOUT rewriting history: insert the new version as a
        # fresh row (inheriting project/file/tags/meta when not provided,
        # plus confidence boost and access stats for ranking continuity),
        # then point the old row at it via superseded_by. The old row keeps
        # its original content and timestamp; read paths skip it and prune
        # can eventually delete it.
        # Use stdin to avoid ARG_MAX overflow on large summary/metadata text.
        id=$(_db_stdin <<SQL
INSERT INTO observations (session_id, type, topic, summary, project, file_path, tags, metadata, confidence, private, access_count, last_accessed)
SELECT $sid, '$(_escape "$type")', '$esc_topic', '$esc_summary',
       COALESCE(NULLIF('$esc_project',''), project),
       COALESCE(NULLIF('$esc_file',''), file_path),
       COALESCE(NULLIF('$esc_tags',''), tags),
       COALESCE(NULLIF('$esc_meta',''), metadata),
       MIN(1.0, MAX(confidence + 0.1, $confidence)), $private, access_count, last_accessed
FROM observations WHERE id = $dup_id;
UPDATE observations SET superseded_by = last_insert_rowid() WHERE id = $dup_id;
SELECT last_insert_rowid();
SQL
)
        echo "🔄 Superseded observation #$dup_id → new #$id (similarity: $dup_sim): $topic"
    else
        # Use stdin to avoid ARG_MAX overflow on large summary/metadata text.
        id=$(_db_stdin <<SQL
INSERT INTO observations (session_id, type, topic, summary, project, file_path, tags, metadata, confidence, private)
VALUES ($sid, '$(_escape "$type")', '$esc_topic', '$esc_summary',
        NULLIF('$esc_project',''), NULLIF('$esc_file',''),
        NULLIF('$esc_tags',''), NULLIF('$esc_meta',''), $confidence, $private);
SELECT last_insert_rowid();
SQL
)
        echo "✅ Saved observation #$id: $topic"
    fi
    # (knowledge.md mirroring is removed: it grew append-only and was never
    #  read. Archived copy in ~/.amp/memory/archive/.)
}

cmd_search() {
    _ensure_db
    local query="${1:?Usage: amp-mem search <query> [--type T] [--project P] [--after DATE] [--before DATE] [--limit N]}"
    shift

    local type="" project="" after="" before="" limit="20"
    local include_private=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --type)    type="$2"; shift 2 ;;
            --project) project="$2"; shift 2 ;;
            --after)   after="$2"; shift 2 ;;
            --before)  before="$2"; shift 2 ;;
            --limit)   _require_int "$2"; limit="$2"; shift 2 ;;
            --include-private) include_private=1; shift ;;
            *) shift ;;
        esac
    done

    local esc_query; esc_query=$(_escape "$query")

    # Build WHERE clauses for additional filters
    local where_extra=""
    [ -n "$type" ]    && where_extra="$where_extra AND o.type = '$(_escape "$type")'"
    # A project scope also admits rows with no project: legacy rows were
    # saved before any passive path set --project, and a scoped
    # search that hid them would make the plugin's scoped-first pass lose
    # history. Rows tagged with ANOTHER project stay out.
    [ -n "$project" ] && where_extra="$where_extra AND (o.project = '$(_escape "$project")' OR o.project IS NULL)"
    [ -n "$after" ]   && where_extra="$where_extra AND o.ts >= '$(_escape "$after")'"
    [ -n "$before" ]  && where_extra="$where_extra AND o.ts <= '$(_escape "$before")'"
    [ "$include_private" -eq 0 ] && where_extra="$where_extra AND o.private = 0"
    # Superseded rows are always hidden from search — the live successor
    # carries the current content (detail <id> can still fetch them).
    where_extra="$where_extra AND o.superseded_by IS NULL"

    _db <<SQL
.mode column
.headers on
.width 5 20 12 40 30
SELECT o.id,
       substr(o.ts, 1, 10) AS date,
       o.type,
       substr(o.topic, 1, 40) AS topic,
       substr(o.summary, 1, 60) AS summary_preview
FROM observations_fts f
JOIN observations o ON o.id = f.rowid
WHERE observations_fts MATCH '$esc_query'
$where_extra
ORDER BY rank
LIMIT $limit;
SQL

    # Track access: increment access_count for returned observations
    _db "UPDATE observations SET
            access_count = access_count + 1,
            last_accessed = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')
         WHERE id IN (
            SELECT o.id FROM observations_fts f
            JOIN observations o ON o.id = f.rowid
            WHERE observations_fts MATCH '$esc_query'
            $where_extra
            ORDER BY rank LIMIT $limit
         );" 2>/dev/null
}

cmd_timeline() {
    _ensure_db
    local id="${1:?Usage: amp-mem timeline <id> [--window N]}"
    shift
    _require_int "$id"
    local window=5

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --window) _require_int "$2"; window="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    # Get the timestamp of the target observation
    local target_ts
    target_ts=$(_db "SELECT ts FROM observations WHERE id = $id;")

    if [ -z "$target_ts" ]; then
        echo "❌ Observation #$id not found" >&2
        exit 1
    fi

    _db <<SQL
.mode column
.headers on
.width 5 20 12 50 80
SELECT id,
       ts AS timestamp,
       type,
       topic,
       summary
FROM observations
WHERE private = 0
  AND ts BETWEEN datetime('$target_ts', '-${window} hours')
             AND datetime('$target_ts', '+${window} hours')
ORDER BY ts;
SQL
}

cmd_detail() {
    _ensure_db
    if [ $# -eq 0 ]; then
        echo "Usage: amp-mem detail <id1> [<id2> ...]" >&2
        exit 1
    fi

    local ids arg
    for arg in "$@"; do _require_int "$arg"; done
    ids=$(printf "%s," "$@")
    ids="${ids%,}"

    _db <<SQL
.mode column
.headers on
.width 5 20 12 12 50 0 15 30 20
SELECT id, ts AS timestamp, type, project, topic, summary, file_path, tags, metadata
FROM observations
WHERE id IN ($ids)
ORDER BY ts;
SQL

    # A detail fetch is a retrieval (the budget block's footer sends the
    # agent here), so it counts toward access_count exactly like a search
    # hit. Without this the §9 hit-rate metric would under-count every
    # index-first lookup.
    _db "UPDATE observations SET
            access_count = access_count + 1,
            last_accessed = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')
         WHERE id IN ($ids);" 2>/dev/null
}

cmd_context() {
    _ensure_db
    local lines=50
    # Budget mode: --budget-chars N switches to a
    # scoped, index-first block (one line per row with its #id) capped at N
    # characters. --project boosts rows of the current workstream/repo,
    # --session + --log record what was injected in injection_log so retrieval
    # after injection can be measured (never bumps access_count). Without
    # --budget-chars the legacy --lines output is unchanged.
    local project="" budget_chars=0 session_id="" log=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lines) _require_int "$2"; lines="$2"; shift 2 ;;
            --project) project="$2"; shift 2 ;;
            --budget-chars) _require_int "$2"; budget_chars="$2"; shift 2 ;;
            --session) session_id="$2"; shift 2 ;;
            --log) log=1; shift ;;
            *) shift ;;
        esac
    done

    # Use python3 for decay computation and budgeted output
    python3 - "$DB" "$lines" "$project" "$budget_chars" "$session_id" "$log" <<'PYEOF'
import sqlite3, sys, math, json
from datetime import datetime, timezone

db_path = sys.argv[1]
max_lines = int(sys.argv[2])
cur_project = sys.argv[3] or None
budget_chars = int(sys.argv[4] or 0)
session_id = sys.argv[5] or None
log_injection = sys.argv[6] == '1'

total_lines = 0

def emit(text=''):
    """Count every emitted line, including headings and multiline archives."""
    global total_lines
    for line in str(text).split('\n'):
        if total_lines >= max_lines:
            return
        print(line)
        total_lines += 1

conn = sqlite3.connect(db_path)
conn.row_factory = sqlite3.Row

# Half-life in days for decaying types (0 = permanent)
HALF_LIVES = {
    'architecture': 0, 'decision': 0, 'pattern': 0, 'gotcha': 0,
    'preference': 0, 'config': 0, 'workflow': 0, 'people': 0,
    'distilled': 0,
    'observation': 14, 'bugfix': 30, 'discovery': 21,
    'session': 7, 'thread': 7,
}

# Line budgets per type (total ~150 lines like claude-mem)
BUDGETS = {
    'distilled': 10, 'decision': 25, 'preference': 15, 'config': 15,
    'workflow': 15, 'discovery': 15, 'people': 10,
    'bugfix': 10, 'observation': 20, 'pattern': 10,
    'architecture': 10, 'gotcha': 10,
    'session': 5, 'thread': 5,
}

# Noise patterns to filter from context output — routine tool calls
# that clutter the context without adding useful information
NOISE_PREFIXES = [
    'Ran command:', 'amp_mem_', 'Searched Gmail:', 'Read email:',
    'Searched Slack:', 'Fetched Notion page:', 'Searched Google Drive:',
    'User prompt:', 'amp_mem_stats', 'amp_mem_search',
]

# Topics about the memory system itself — useful during build, not for daily work
META_KEYWORDS = [
    'amp-mem', 'amp memory', 'memory system', 'memory web viewer',
    'kb-distill', 'distill skill', 'vector embeddings',
    'claude-mem', 'second me flywheel',
]

def effective_confidence(row):
    """Compute confidence with time-based decay."""
    base = row['confidence'] if row['confidence'] else 1.0
    obs_type = row['type'] or 'observation'
    half_life = HALF_LIVES.get(obs_type, 14)
    if half_life == 0:
        return base  # permanent type
    try:
        ts = datetime.fromisoformat(row['ts'].replace('Z', '+00:00'))
        now = datetime.now(timezone.utc)
        days = (now - ts).total_seconds() / 86400
        decay = math.pow(0.5, days / half_life)
        return base * decay
    except:
        return base

def rank_recency(row):
    """Mild recency factor for RANKING only (never filters rows out).

    Permanent types have no confidence decay, so without this a
    much-accessed March decision outranks every July decision forever
    (the exact failure mode: context's Decisions section led with
    4-month-old entries while recent ones hid behind "...N more").
    90-day half-life: a 3-month-old entry ranks at half weight — strong
    enough that recency beats the capped access bonus for stale rows.
    """
    try:
        ts = datetime.fromisoformat(row['ts'].replace('Z', '+00:00'))
        days = (datetime.now(timezone.utc) - ts).total_seconds() / 86400
        return math.pow(0.5, days / 90)
    except:
        return 1.0

def score(row):
    """Rank by effective_confidence × capped access bonus × rank recency.

    The access bonus is log-dampened AND capped at 2x: legacy rows carry
    access_counts (up to ~12) accumulated over months of searches against
    the old 67k-row DB, so an uncapped multiplier let frequency bury
    recency entirely. Capped, a genuinely-referenced recent row still
    outranks an unreferenced one, but a stale row can't ride old counts
    past fresh entries (2.0 x 90-day-recency 0.5 < fresh 1.0).
    """
    ec = effective_confidence(row)
    ac = min(2.0, 1 + math.log2(1 + (row['access_count'] or 0)) / 3)
    return ec * ac * rank_recency(row)

# Fetch all active observations, excluding compacted ones (per-row marker)
rows = conn.execute("""
    SELECT id, ts, type, topic, summary, project, tags,
           confidence, access_count
    FROM observations
    WHERE private = 0 AND compacted_at IS NULL AND superseded_by IS NULL
    ORDER BY ts DESC
""").fetchall()

if not rows:
    emit("# Amp Memory — No observations yet")
    sys.exit(0)

# Filter out very low confidence (< 0.15) and noisy routine observations
active = [(r, effective_confidence(r)) for r in rows]
active = [(r, ec) for r, ec in active if ec >= 0.15]

def is_noisy(row):
    """Filter routine tool-call observations that clutter context."""
    topic = row['topic'] or ''
    if any(topic.startswith(p) for p in NOISE_PREFIXES):
        return True
    # Filter meta entries about the memory system itself
    topic_lower = topic.lower()
    project = (row['project'] or '').lower()
    if project in ('amp-memory', 'second-me'):
        return True
    if any(kw in topic_lower for kw in META_KEYWORDS):
        return True
    return False

active = [(r, ec) for r, ec in active if not is_noisy(r)]

# Group by type
by_type = {}
for r, ec in active:
    t = r['type'] or 'observation'
    by_type.setdefault(t, []).append((r, ec))

# Sort each group by score descending
for t in by_type:
    by_type[t].sort(key=lambda x: score(x[0]), reverse=True)

# ---------------------------------------------------------------------------
# Budget mode: scoped, index-first, hard character cap (chars, not bytes;
# multi-byte text costs a little more in tokens than the cap suggests).
# One archived summary (≤500 chars), then one line per row ordered by
# score() with a 2x boost for the current project, then a footer that names
# the fetch path. 30 % of the row budget is reserved for rows under 7 days
# old so the block is not a static greatest-hits list. Row ids are logged
# (never bumped: injection is not retrieval).
# ---------------------------------------------------------------------------
if budget_chars > 0:
    out = []
    used = 0

    def take(line):
        """Append a line if it fits the budget; return False when it does not."""
        global used
        cost = len(line) + 1
        if used + cost > budget_chars:
            return False
        out.append(line)
        used += cost
        return True

    FOOTER = ("Fetch detail: `amp-mem detail <id>`; search the archive: "
              "`amp_mem_search` (defaults to this project, falls back to all).")
    reserve = len(FOOTER) + 2
    if budget_chars < reserve + 80:
        print(f"amp-mem context: --budget-chars {budget_chars} is below the "
              f"minimum {reserve + 80}", file=sys.stderr)
        sys.exit(2)

    header = "# Amp Memory" + (f" — {cur_project}" if cur_project else "")
    take(header)
    take("")

    summary_row = conn.execute("""
        SELECT period_start, period_end, ai_summary
        FROM summaries
        WHERE ai_summary IS NOT NULL AND ai_summary != ''
        ORDER BY period_end DESC, period_start DESC, created_at DESC LIMIT 1
    """).fetchone()
    if summary_row:
        text = ' '.join(summary_row['ai_summary'].split())
        if len(text) > 500:
            cut = text[:500]
            idx = cut.rfind('. ')
            text = (cut[:idx + 1] if idx > 200 else cut.rstrip() + '…')
        take(f"Archived {summary_row['period_start'][:10]} to "
             f"{summary_row['period_end'][:10]}: {text}")
        take("")

    def budget_score(row):
        s = score(row)
        if cur_project and (row['project'] or '') == cur_project:
            s *= 2.0
        return s

    def is_junk(row):
        """Rows with nothing to say: empty or literal 'undefined' topics, or a
        summary too short to carry a fact (#73724 'preference: undefined —
        undefined' and #71146 'decision: I do' made the first live block)."""
        topic = ' '.join((row['topic'] or '').split())
        summary_text = ' '.join((row['summary'] or '').split())
        if topic.lower() in ('', 'undefined', 'null', 'none'):
            return True
        if summary_text.lower() in ('undefined', 'null'):
            return True
        return len(summary_text) < 20 and len(topic) < 20

    def is_recent(row):
        try:
            ts = datetime.fromisoformat(row['ts'].replace('Z', '+00:00'))
            return (datetime.now(timezone.utc) - ts).total_seconds() < 7 * 86400
        except Exception:
            return False

    def render(row):
        date = row['ts'][:10] if row['ts'] else '?'
        topic = ' '.join((row['topic'] or '').split())
        summary_text = ' '.join((row['summary'] or '').split())
        if len(summary_text) > 80:
            summary_text = summary_text[:80].rstrip() + '…'
        proj = (f" [{row['project']}]"
                if row['project'] and row['project'] != cur_project else "")
        line = f"- #{row['id']} [{date}] {row['type'] or 'observation'}: {topic}{proj}"
        if summary_text and summary_text != topic:
            line += f" — {summary_text}"
        return line

    candidates = [r for r, ec in active if not is_junk(r)]
    recent = sorted((r for r in candidates if is_recent(r)), key=budget_score, reverse=True)
    older = sorted((r for r in candidates if not is_recent(r)), key=budget_score, reverse=True)

    row_budget = budget_chars - used - reserve
    recent_cap = used + int(row_budget * 0.3)
    injected_ids = []

    # Pass 1: recent rows, up to 30 % of the row budget.
    for r in recent:
        line = render(r)
        if used + len(line) + 1 > recent_cap:
            break
        take(line)
        injected_ids.append(r['id'])
    # Pass 2: everything else by score, recent leftovers included, until the
    # budget (minus the footer) is spent. Stop at the first line that does not
    # fit; a smaller later line would scramble the ranking the agent reads.
    leftovers = [r for r in recent if r['id'] not in set(injected_ids)]
    for r in sorted(leftovers + older, key=budget_score, reverse=True):
        line = render(r)
        if used + len(line) + 1 + reserve > budget_chars:
            break
        take(line)
        injected_ids.append(r['id'])

    take("")
    take(FOOTER)
    print('\n'.join(out))

    if log_injection:
        # The block is already printed; a logging failure must not turn the
        # injection into an empty string (the plugin treats a non-zero exit
        # as "no context").
        try:
            conn.execute("""
                CREATE TABLE IF NOT EXISTS injection_log (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now')),
                    session_id TEXT,
                    project TEXT,
                    chars INTEGER,
                    row_ids TEXT
                )
            """)
            conn.execute(
                "INSERT INTO injection_log (session_id, project, chars, row_ids) VALUES (?, ?, ?, ?)",
                (session_id, cur_project, used, json.dumps(injected_ids)))
            conn.commit()
        except Exception as e:
            print(f"amp-mem context: injection_log write failed: {e}", file=sys.stderr)
    conn.close()
    sys.exit(0)

# Compute used/unused budgets
used_budgets = {}
unused_lines = 0
for t, budget in BUDGETS.items():
    count = len(by_type.get(t, []))
    used = min(count, budget)
    used_budgets[t] = used
    unused_lines += budget - used

# Redistribute unused budget to types that have more entries
overflow_types = [t for t in BUDGETS if len(by_type.get(t, [])) > BUDGETS[t]]
if overflow_types and unused_lines > 0:
    per_type = unused_lines // len(overflow_types)
    for t in overflow_types:
        used_budgets[t] = min(len(by_type.get(t, [])), BUDGETS[t] + per_type)

# Output
emit("# Amp Memory — Recent Context")
emit()

# Show compacted summaries first — AI summaries ONLY. The old raw-topic
# fallback dumped file lists and "Bash, Bash, Bash" tool noise into every
# session's context. Periods without an ai_summary are omitted; the plugin
# backfills ai_summary via generateAISummaries at session start.
summaries_rows = conn.execute("""
    SELECT period_start, period_end, ai_summary
    FROM summaries
    WHERE ai_summary IS NOT NULL AND ai_summary != ''
    ORDER BY period_end DESC, period_start DESC, created_at DESC LIMIT 3
""").fetchall()
if summaries_rows:
    emit("## Archived Knowledge")
    emit()
    for s in summaries_rows:
        emit(f"### {s['period_start'][:10]} to {s['period_end'][:10]}")
        emit(s['ai_summary'])
        emit()
    emit()

# Output each type section
TYPE_LABELS = {
    'distilled': '🧠 Distilled Knowledge', 'decision': '🎯 Decisions',
    'preference': '⭐ Preferences', 'config': '⚙️ Configuration',
    'workflow': '🔄 Workflows', 'discovery': '💡 Discoveries',
    'people': '👥 People', 'bugfix': '🐛 Bug Fixes',
    'observation': '📝 Observations', 'pattern': '🧩 Patterns',
    'architecture': '🏗️ Architecture', 'gotcha': '⚠️ Gotchas',
    'session': '📋 Sessions', 'thread': '🧵 Threads',
}

# Order: distilled knowledge first, then permanent types, then decaying
type_order = ['distilled', 'decision', 'preference', 'config', 'workflow',
              'architecture', 'pattern', 'gotcha', 'people', 'discovery',
              'bugfix', 'observation', 'session', 'thread']

for t in type_order:
    if total_lines >= max_lines:
        break
    entries = by_type.get(t, [])
    if not entries:
        continue
    budget = used_budgets.get(t, BUDGETS.get(t, 10))
    label = TYPE_LABELS.get(t, t.title())

    emit(f"## {label}")
    emit()
    for i, (r, ec) in enumerate(entries[:budget]):
        if total_lines >= max_lines:
            break
        date = r['ts'][:10] if r['ts'] else '?'
        conf_indicator = '●' if ec > 0.7 else '◐' if ec > 0.4 else '○'
        project_tag = f" [{r['project']}]" if r['project'] else ""
        emit(f"- {conf_indicator} **[{date}] {r['topic']}**{project_tag}")
        # Print summary (truncated at sentence boundary, max ~400 chars)
        summary_text = (r['summary'] or '').replace('\n', ' ')
        if len(summary_text) > 400:
            # Try to cut at a sentence boundary
            cut = summary_text[:400]
            for sep in ['. ', '! ', '? ', '; ']:
                idx = cut.rfind(sep)
                if idx > 150:
                    cut = cut[:idx+1]
                    break
            else:
                # No sentence boundary found — cut at last space
                idx = cut.rfind(' ')
                if idx > 150:
                    cut = cut[:idx] + '…'
                else:
                    cut = cut + '…'
            summary_text = cut
        if summary_text:
            emit(f"  {summary_text}")
    if total_lines >= max_lines:
        break
    emit()

conn.close()
PYEOF
}

cmd_compact() {
    _ensure_db

    # ── Concurrency lock ─────────────────────────────────────────────────
    # mkdir is atomic on POSIX. Prevents overlapping compact runs from
    # racing on the same SQLite DB and piling up RAM/CPU. Stale locks
    # (older than 60 minutes) are auto-cleared so a crashed run can't
    # block future compactions forever.
    local lockdir="$HOME/.amp/memory/.compact.lock"
    if [ -d "$lockdir" ]; then
        local lock_mtime now lock_age_min
        lock_mtime=$(stat -c %Y "$lockdir" 2>/dev/null || stat -f %m "$lockdir" 2>/dev/null || echo 0)
        now=$(date +%s)
        lock_age_min=$(( (now - lock_mtime) / 60 ))
        if [ "$lock_age_min" -gt 60 ]; then
            echo "⚠️  Removing stale compact lock (${lock_age_min} min old)" >&2
            rmdir "$lockdir" 2>/dev/null || rm -rf "$lockdir"
        fi
    fi
    if ! mkdir "$lockdir" 2>/dev/null; then
        echo "ℹ️  Another amp-mem compact is already running. Skipping." >&2
        return 0
    fi
    trap "rmdir '$lockdir' 2>/dev/null || true" EXIT INT TERM

    local older_than=30

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --older-than) _require_int "$2"; older_than="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local cutoff
    cutoff=$(date -v-${older_than}d +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -d "${older_than} days ago" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null)

    # Per-row model: any observation past the cutoff with no compacted_at
    # marker is pending, regardless of whether its week already has a
    # summary. Decaying types only — permanent types (decisions,
    # preferences, distilled, etc.) stay active forever and are never
    # rolled into weekly archives.
    # private = 0: private rows must never be rolled into weekly summaries —
    # summary text is injected into future session context, which would leak
    # the private content. Private rows stay raw (they're tiny in number).
    # superseded_by IS NULL: superseded rows are stale versions whose content
    # lives on in their successor — rolling them into summaries would
    # double-count. They're prune-eligible directly instead.
    local pending_where="compacted_at IS NULL AND private = 0 AND superseded_by IS NULL AND ts < '$cutoff' AND type IN ('observation','session','thread','bugfix','discovery')"

    local count
    count=$(_db "SELECT COUNT(*) FROM observations WHERE $pending_where;")

    if [ "$count" -eq 0 ]; then
        # Successful no-op: still record state so cmd_compact_status sees fresh health.
        local state_file="$HOME/.amp/memory/.compact-status.json"
        local total_summaries
        total_summaries=$(_db "SELECT COUNT(*) FROM summaries;")
        cat > "$state_file" <<EOF
{
  "last_success_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "observations_pending_at_start": 0,
  "total_summaries": $total_summaries,
  "older_than_days": $older_than
}
EOF
        echo "ℹ️  No observations older than $older_than days to compact."
        return
    fi

    echo "📦 Compacting $count observations older than $older_than days..."

    # Group pending observations by week
    local weeks
    weeks=$(_db "SELECT DISTINCT strftime('%Y-W%W', ts) FROM observations WHERE $pending_where ORDER BY 1;")

    while IFS= read -r week; do
        [ -z "$week" ] && continue

        local week_where="$pending_where AND strftime('%Y-W%W', ts) = '$week'"
        local period_start period_end obs_count obs_text

        period_start=$(_db "SELECT MIN(ts) FROM observations WHERE $week_where;")
        period_end=$(_db "SELECT MAX(ts) FROM observations WHERE $week_where;")
        obs_count=$(_db "SELECT COUNT(*) FROM observations WHERE $week_where;")

        # Concatenate the week's observations into a summary body
        obs_text=$(_db "SELECT group_concat(type || ': ' || topic || ' — ' || summary, char(10)) FROM observations WHERE $week_where;")

        local esc_text; esc_text=$(_escape "$obs_text")

        # Append to the week's existing summary if one exists (late-arriving
        # rows), otherwise create it. Then mark the rows compacted — this is
        # what makes the pipeline convergent. Use stdin to avoid ARG_MAX
        # overflow on large weekly text.
        local existing_id
        existing_id=$(_db "SELECT id FROM summaries WHERE strftime('%Y-W%W', period_start) = '$week' ORDER BY id LIMIT 1;")

        if [ -n "$existing_id" ]; then
            _db_stdin <<SQL
UPDATE summaries SET
    summary = summary || char(10) || '$esc_text',
    period_end = MAX(period_end, '$period_end'),
    ai_summary = NULL
WHERE id = $existing_id;
UPDATE observations SET compacted_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')
WHERE $week_where;
SQL
            echo "  ✓ Appended $obs_count observations to existing summary for week $week"
        else
            _db_stdin <<SQL
INSERT INTO summaries (period_start, period_end, summary)
VALUES ('$period_start', '$period_end', '$esc_text');
UPDATE observations SET compacted_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')
WHERE $week_where;
SQL
            echo "  ✓ Compacted week $week ($obs_count observations)"
        fi

    done <<< "$weeks"

    # Record success state for monitoring (cmd_compact_status reads this).
    local state_file="$HOME/.amp/memory/.compact-status.json"
    local total_summaries
    total_summaries=$(_db "SELECT COUNT(*) FROM summaries;")
    cat > "$state_file" <<EOF
{
  "last_success_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "observations_pending_at_start": $count,
  "total_summaries": $total_summaries,
  "older_than_days": $older_than
}
EOF

    echo "✅ Compaction complete. Original observations preserved (not deleted)."
}

cmd_compact_status() {
    _ensure_db
    local state_file="$HOME/.amp/memory/.compact-status.json"
    local stale_hours=24

    echo "📊 Compact Status"

    if [ ! -f "$state_file" ]; then
        echo "  Last success:   never (no successful compact recorded)"
        echo "  ⚠️  Run: amp-mem compact --older-than 7"
        return 1
    fi

    local last_success
    last_success=$(python3 -c "import json; print(json.load(open('$state_file')).get('last_success_at',''))" 2>/dev/null)

    if [ -z "$last_success" ]; then
        echo "  ⚠️  Status file present but unparseable: $state_file"
        return 1
    fi

    local last_epoch now_epoch age_h
    last_epoch=$(python3 -c "from datetime import datetime, timezone; print(int(datetime.strptime('$last_success', '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc).timestamp()))" 2>/dev/null || echo 0)
    now_epoch=$(date +%s)
    age_h=$(( (now_epoch - last_epoch) / 3600 ))

    echo "  Last success:   $last_success (${age_h}h ago)"

    cat "$state_file" | python3 -c "import json,sys; d=json.load(sys.stdin); print(f'  Pending then:   {d.get(\"observations_pending_at_start\",\"?\")}'); print(f'  Total summaries: {d.get(\"total_summaries\",\"?\")}')"

    # Live pending count — the real backlog, not the stale snapshot.
    # (Counting only never-summarized weeks would report "0 pending / Healthy"
    # while dead-zone rows pile up.)
    # Must match compact's eligibility filter (private=0, not superseded) —
    # otherwise superseded/private rows count as "pending" forever and the
    # warning can never clear.
    local live_pending
    live_pending=$(_db "SELECT COUNT(*) FROM observations WHERE compacted_at IS NULL AND private = 0 AND superseded_by IS NULL AND ts < datetime('now', '-7 days') AND type IN ('observation','session','thread','bugfix','discovery');")
    echo "  Pending now:    $live_pending"

    if [ "$age_h" -gt "$stale_hours" ]; then
        echo "  ⚠️  Stale (>${stale_hours}h since last success). Run: amp-mem compact --older-than 7"
        return 1
    fi

    if [ "$live_pending" -gt 200 ]; then
        echo "  ⚠️  Backlog: $live_pending uncompacted observations. Run: amp-mem compact --older-than 7"
        return 1
    fi

    echo "  ✅ Healthy"
    return 0
}

cmd_prune() {
    _ensure_db
    local older_than=90
    local commit=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --older-than) _require_int "$2"; older_than="$2"; shift 2 ;;
            --commit)     commit=1; shift ;;
            *) shift ;;
        esac
    done

    local cutoff
    cutoff=$(date -v-${older_than}d +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -d "${older_than} days ago" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null)

    # Only prune obs whose content is represented elsewhere:
    #  - compacted_at set: the row was rolled into a weekly summary, OR
    #  - superseded_by set: a newer version of the row carries its content.
    # The old week-based heuristic was unsafe: rows added to a week after
    # its summary existed were in a "summarized week" without being in any
    # summary, so pruning would have silently destroyed them.
    local where_clause="ts < '$cutoff' AND (compacted_at IS NOT NULL OR superseded_by IS NOT NULL)"

    local prunable
    prunable=$(_db "SELECT COUNT(*) FROM observations WHERE $where_clause;")

    if [ "$prunable" -eq 0 ]; then
        echo "ℹ️  No observations older than $older_than days are eligible for pruning (must be compacted or superseded first)."
        return 0
    fi

    if [ "$commit" -eq 0 ]; then
        echo "📋 Dry run: $prunable observations older than $older_than days would be deleted."
        echo "   Each is either rolled into a compacted summary or superseded by a newer version."
        echo "   To actually delete: amp-mem prune --older-than $older_than --commit"
        # Show breakdown by week
        _db <<SQL
.mode column
.headers on
.width 12 8
SELECT strftime('%Y-W%W', ts) AS week, COUNT(*) AS to_delete
FROM observations
WHERE $where_clause
GROUP BY week ORDER BY week;
SQL
        return 0
    fi

    # Guaranteed fresh snapshot before deletion — the daily backup may be
    # hours old and would not protect data written since it was taken.
    local snap="$DB.backup-$(date +%Y-%m-%d-%H%M%S)-pre-prune"
    echo "💾 Taking pre-prune snapshot: $snap"
    if ! sqlite3 "$DB" ".backup '$snap'"; then
        echo "❌ Pre-prune snapshot failed; aborting prune." >&2
        return 1
    fi

    local before_size
    before_size=$(stat -c %s "$DB" 2>/dev/null || stat -f %z "$DB" 2>/dev/null || echo 0)

    echo "🗑️  Deleting $prunable observations older than $older_than days (already summarized)..."
    _db "DELETE FROM observations WHERE $where_clause;"

    echo "🧹 VACUUM to reclaim disk space..."
    _db "VACUUM;"

    local after_size
    after_size=$(stat -c %s "$DB" 2>/dev/null || stat -f %z "$DB" 2>/dev/null || echo 0)
    local saved_mb=$(( (before_size - after_size) / 1024 / 1024 ))

    echo "✅ Pruned $prunable observations. DB shrank by ~${saved_mb}MB."
}

cmd_session_start() {
    _ensure_db
    local thread_url=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --thread-url) thread_url="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local esc_url; esc_url=$(_escape "$thread_url")

    local id
    id=$(_db "INSERT INTO sessions (thread_url) VALUES (NULLIF('$esc_url', ''));
              SELECT last_insert_rowid();")

    echo "$id"
}

cmd_session_end() {
    _ensure_db
    local session_id="" summary=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --session) _require_int "$2"; session_id="$2"; shift 2 ;;
            --summary) summary="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -z "$session_id" ]; then
        session_id=$(_db "SELECT id FROM sessions ORDER BY id DESC LIMIT 1;")
    fi

    if [ -n "$summary" ]; then
        local esc; esc=$(_escape "$summary")
        # Use stdin to avoid ARG_MAX overflow on large session summaries.
        _db_stdin <<SQL
UPDATE sessions SET ended_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now'), summary = '$esc' WHERE id = $session_id;
SQL
    else
        _db "UPDATE sessions SET ended_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = $session_id;"
    fi

    echo "✅ Session #$session_id ended."
}

cmd_stats() {
    _ensure_db
    echo "📊 Amp Memory Statistics"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    local total obs_types sessions summaries db_size first_entry last_entry

    total=$(_db "SELECT COUNT(*) FROM observations;")
    sessions=$(_db "SELECT COUNT(*) FROM sessions;")
    summaries=$(_db "SELECT COUNT(*) FROM summaries;")
    db_size=$(du -h "$DB" 2>/dev/null | cut -f1)
    first_entry=$(_db "SELECT MIN(ts) FROM observations;" 2>/dev/null)
    last_entry=$(_db "SELECT MAX(ts) FROM observations;" 2>/dev/null)

    echo "  Observations:    $total"
    echo "  Sessions:        $sessions"
    echo "  Compacted:       $summaries weekly summaries"
    echo "  Database size:   $db_size"
    echo "  First entry:     ${first_entry:-n/a}"
    echo "  Last entry:      ${last_entry:-n/a}"
    echo ""

    echo "  By type:"
    _db <<SQL
.mode column
.width 20 8
SELECT type, COUNT(*) AS count FROM observations GROUP BY type ORDER BY count DESC;
SQL

    echo ""
    echo "  By project:"
    _db <<SQL
.mode column
.width 30 8
SELECT COALESCE(project, '(none)') AS project, COUNT(*) AS count FROM observations GROUP BY project ORDER BY count DESC LIMIT 10;
SQL
}

cmd_export() {
    _ensure_db
    local format="md"
    local include_private=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --format) format="$2"; shift 2 ;;
            --include-private) include_private=1; shift ;;
            *) shift ;;
        esac
    done

    # Exports tend to get shared or moved off-machine; exclude private
    # rows unless explicitly requested.
    local priv_where="WHERE private = 0"
    [ "$include_private" -eq 1 ] && priv_where=""

    case "$format" in
        json)
            _db_json "SELECT * FROM observations $priv_where ORDER BY ts;"
            ;;
        md)
            echo "# Amp Memory Export"
            echo ""
            echo "Exported: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
            echo ""
            echo "---"

            _db <<SQL
.mode list
.separator "\n"
SELECT char(10) || '## [' || substr(ts, 1, 10) || '] ' || topic || char(10) || char(10) ||
       '**Type:** ' || type ||
       CASE WHEN project IS NOT NULL THEN ' | **Project:** ' || project ELSE '' END ||
       CASE WHEN file_path IS NOT NULL THEN ' | **File:** ' || file_path ELSE '' END ||
       CASE WHEN tags IS NOT NULL THEN ' | **Tags:** ' || tags ELSE '' END ||
       char(10) || char(10) || summary || char(10) || char(10) || '---'
FROM observations $priv_where ORDER BY ts;
SQL
            ;;
        *)
            echo "❌ Unknown format: $format (use md or json)" >&2
            exit 1
            ;;
    esac
}

cmd_serve() {
    local port=37777

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --port) _require_int "$2"; port="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    echo "🌐 Starting Amp Memory web viewer on http://localhost:$port"
    echo "   Press Ctrl+C to stop."
    python3 "$HOME/.amp/memory/web/serve.py" "$port"
}

cmd_migrate() {
    _ensure_db

    # Check if sessions.jsonl exists and has content
    local jsonl="$HOME/.amp/memory/sessions.jsonl"
    if [ ! -f "$jsonl" ] || [ ! -s "$jsonl" ]; then
        echo "ℹ️  No sessions.jsonl to migrate."
        return
    fi

    local count=0
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local ts topic summary
        ts=$(echo "$line" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('ts',''))" 2>/dev/null) || continue
        topic=$(echo "$line" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('topic',''))" 2>/dev/null) || continue
        summary=$(echo "$line" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('summary',''))" 2>/dev/null) || continue

        [ -z "$topic" ] && continue

        local esc_topic; esc_topic=$(_escape "$topic")
        local esc_summary; esc_summary=$(_escape "$summary")

        # Use stdin to avoid ARG_MAX overflow on large summary text.
        _db_stdin <<SQL
INSERT INTO observations (ts, type, topic, summary) VALUES ('$ts', 'observation', '$esc_topic', '$esc_summary');
SQL
        count=$((count + 1))
    done < "$jsonl"

    echo "✅ Migrated $count entries from sessions.jsonl"
}

cmd_ingest_thread() {
    _ensure_db

    # Usage: amp-mem ingest-thread <thread_id> <title> <summary> [--date DATE] [--url URL] [--tags T]
    local thread_id="${1:?Usage: amp-mem ingest-thread <thread_id> <title> <summary> [--date DATE] [--url URL] [--tags T]}"
    local title="${2:?Usage: amp-mem ingest-thread <thread_id> <title> <summary>}"
    local summary="${3:?Usage: amp-mem ingest-thread <thread_id> <title> <summary>}"
    shift 3

    local date="" url="" tags=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --date) date="$2"; shift 2 ;;
            --url)  url="$2"; shift 2 ;;
            --tags) tags="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    # Only an Amp thread (T-...) has a web link.
    case "$thread_id" in T-*) [ -z "$url" ] && url="https://ampcode.com/threads/$thread_id" ;; esac

    # De-duplicate: skip if this thread_id is already stored
    local existing
    existing=$(_db "SELECT COUNT(*) FROM observations WHERE type = 'thread' AND metadata LIKE '%$(_escape "$thread_id")%';")
    if [ "$existing" -gt 0 ]; then
        echo "⏭️  Thread $thread_id already ingested, skipping."
        return 0
    fi

    local esc_title; esc_title=$(_escape "$title")
    local esc_summary; esc_summary=$(_escape "$summary")
    local esc_url; esc_url=$(_escape "$url")
    local esc_tags; esc_tags=$(_escape "$tags")
    local esc_meta; esc_meta=$(_escape "{\"thread_id\":\"$thread_id\",\"url\":\"$url\"}")

    local ts_clause=""
    if [ -n "$date" ]; then
        ts_clause="'$(_escape "$date")'"
    else
        ts_clause="strftime('%Y-%m-%dT%H:%M:%SZ', 'now')"
    fi

    local id
    # Use stdin to avoid ARG_MAX overflow on large thread summaries.
    id=$(_db_stdin <<SQL
INSERT INTO observations (ts, type, topic, summary, tags, metadata)
VALUES ($ts_clause, 'thread', '$esc_title', '$esc_summary',
        NULLIF('$esc_tags',''), '$esc_meta');
SELECT last_insert_rowid();
SQL
)

    echo "✅ Ingested thread #$id: $title"
}

cmd_distill_dump() {
    _ensure_db

    _ensure_distillations

    local since=""
    local limit=500

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --since) since="$2"; shift 2 ;;
            --limit) _require_int "$2"; limit="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    # Default: since last distillation, or all time if never run
    if [ -z "$since" ]; then
        since=$(_db "SELECT COALESCE(MAX(created_at), '1970-01-01T00:00:00Z') FROM distillations;")
    fi

    local count
    count=$(_db "SELECT COUNT(*) FROM observations WHERE ts > '$since' AND private = 0;")

    echo "# Distillation Input"
    echo "# Since: $since"
    echo "# Observations: $count"
    echo "---"
    echo ""

    if [ "$count" -eq 0 ]; then
        echo "No new observations since last distillation."
        return
    fi

    # Dump observations grouped by type, with full details.
    # private = 0: distilled notes are public knowledge — never feed
    # private rows into distillation.
    _db -header -column "SELECT id, ts, type, topic, summary, COALESCE(project,'') as project, COALESCE(tags,'') as tags
         FROM observations
         WHERE ts > '$since' AND private = 0 AND superseded_by IS NULL
         ORDER BY ts ASC
         LIMIT $limit;"
}

cmd_distill_record() {
    _ensure_db

    _ensure_distillations

    local obs_count="${1:?Usage: amp-mem distill-record <obs_count> <notes_produced> <rules_proposed> [summary]}"
    local notes_produced="${2:-0}"
    local rules_proposed="${3:-0}"
    local summary="${4:-}"

    local esc_summary; esc_summary=$(_escape "$summary")

    # Use stdin to avoid ARG_MAX overflow on large distillation summaries.
    _db_stdin <<SQL
INSERT INTO distillations (observation_count, notes_produced, rules_proposed, summary)
VALUES ($obs_count, $notes_produced, $rules_proposed, NULLIF('$esc_summary',''));
SQL

    echo "✅ Distillation recorded (obs=$obs_count, notes=$notes_produced, rules_proposed=$rules_proposed)"
}

cmd_distill_status() {
    _ensure_db

    _ensure_distillations

    local last_run
    last_run=$(_db "SELECT COALESCE(MAX(created_at), 'never') FROM distillations;")

    local pending
    if [ "$last_run" = "never" ]; then
        pending=$(_db "SELECT COUNT(*) FROM observations;")
    else
        pending=$(_db "SELECT COUNT(*) FROM observations WHERE ts > '$last_run';")
    fi

    local total_distillations
    total_distillations=$(_db "SELECT COUNT(*) FROM distillations;")

    echo "📊 Distillation Status"
    echo "  Last run:            $last_run"
    echo "  Pending observations: $pending"
    echo "  Total distillations:  $total_distillations"
}

cmd_decay() {
    # Removed. Stored-confidence decay double-counted with the read-time
    # exponential decay in `context`. Decay is now computed at read time only;
    # stored confidence is a pure quality signal.
    echo "ℹ️  'decay' is deprecated and does nothing. Decay is applied at read time by 'context'."
    return 0
}

cmd_backup() {
    _ensure_db
    local force=0 tag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force) force=1; shift ;;
            --tag)   tag="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local today; today=$(date +%Y-%m-%d)
    local dest="$DB.backup-$today"

    # --tag or --force creates a uniquely named snapshot instead of the
    # daily-idempotent one, so destructive commands can always get a
    # genuinely fresh snapshot even if the daily backup already exists.
    if [ -n "$tag" ]; then
        dest="$DB.backup-$today-$tag"
    elif [ "$force" -eq 1 ]; then
        dest="$DB.backup-$(date +%Y-%m-%d-%H%M%S)"
    fi

    if [ -f "$dest" ] && [ "$force" -eq 0 ]; then
        echo "ℹ️  Backup already exists: $dest (use --force for a fresh timestamped snapshot)"
        return 0
    fi

    # sqlite3 .backup is WAL-safe (takes a consistent snapshot); a plain
    # file copy of a live WAL database can capture a torn/corrupt state.
    # On Git Bash sqlite3 is a native Windows binary: it takes the argv DB path
    # (MSYS converts that) but not a /c/... path inside a dot-command.
    local dest_arg="$dest"
    if command -v cygpath >/dev/null 2>&1; then dest_arg=$(cygpath -m "$dest"); fi
    sqlite3 "$DB" ".backup '$dest_arg'"

    # Rotate: keep 7 days of backups
    find "$(dirname "$DB")" -maxdepth 1 -name 'amp-mem.db.backup-*' -mtime +7 -delete 2>/dev/null || true

    local size
    size=$(stat -c %s "$dest" 2>/dev/null || stat -f %z "$dest" 2>/dev/null || echo 0)
    echo "✅ Backup created: $dest ($(( size / 1024 / 1024 ))MB)"
}

cmd_doctor() {
    _ensure_db
    local fail=0

    echo "🩺 amp-mem doctor"
    echo ""

    # 1. Integrity
    local integrity
    integrity=$(_db "PRAGMA integrity_check;" | head -1)
    if [ "$integrity" = "ok" ]; then
        echo "  ✅ integrity_check: ok"
    else
        echo "  ❌ integrity_check: $integrity"
        fail=1
    fi

    # 2. FTS consistency (row counts must match; triggers keep them in sync)
    local obs_count fts_count
    obs_count=$(_db "SELECT COUNT(*) FROM observations;")
    fts_count=$(_db "SELECT COUNT(*) FROM observations_fts;")
    if [ "$obs_count" = "$fts_count" ]; then
        echo "  ✅ FTS index in sync ($obs_count rows)"
    else
        echo "  ❌ FTS drift: $obs_count observations vs $fts_count FTS rows"
        echo "     Fix: sqlite3 \$DB \"INSERT INTO observations_fts(observations_fts) VALUES('rebuild');\""
        fail=1
    fi

    # 3. Invalid types
    local bad_types
    bad_types=$(_db "SELECT COUNT(*) FROM observations WHERE type NOT IN ($VALID_TYPES_SQL);")
    if [ "$bad_types" -eq 0 ]; then
        echo "  ✅ All observation types valid"
    else
        echo "  ⚠️  $bad_types observations with invalid types:"
        _db "SELECT '     ' || type || ' × ' || COUNT(*) FROM observations WHERE type NOT IN ($VALID_TYPES_SQL) GROUP BY type;"
        fail=1
    fi

    # 4. Pending compaction backlog
    # Same eligibility filter as compact (private=0, not superseded) so the
    # count only includes rows compact can actually clear.
    local pending
    pending=$(_db "SELECT COUNT(*) FROM observations WHERE compacted_at IS NULL AND private = 0 AND superseded_by IS NULL AND ts < datetime('now', '-7 days') AND type IN ('observation','session','thread','bugfix','discovery');")
    if [ "$pending" -le 200 ]; then
        echo "  ✅ Compaction backlog: $pending pending"
    else
        echo "  ⚠️  Compaction backlog: $pending pending (>200). Run: amp-mem compact --older-than 7"
        fail=1
    fi

    # 5. Empty sessions (no observations, ended or stale >1 day)
    local empty_sessions
    empty_sessions=$(_db "SELECT COUNT(*) FROM sessions s WHERE NOT EXISTS (SELECT 1 FROM observations o WHERE o.session_id = s.id) AND s.started_at < datetime('now', '-1 day');")
    if [ "$empty_sessions" -le 50 ]; then
        echo "  ✅ Empty sessions: $empty_sessions"
    else
        echo "  ⚠️  Empty sessions: $empty_sessions (>50). Consider cleanup:"
        echo "     DELETE FROM sessions WHERE id NOT IN (SELECT DISTINCT session_id FROM observations WHERE session_id IS NOT NULL) AND started_at < datetime('now','-1 day');"
        fail=1
    fi

    # 6. DB size
    local size_bytes size_mb
    size_bytes=$(stat -c %s "$DB" 2>/dev/null || stat -f %z "$DB" 2>/dev/null || echo 0)
    size_mb=$(( size_bytes / 1024 / 1024 ))
    if [ "$size_mb" -lt 50 ]; then
        echo "  ✅ DB size: ${size_mb}MB"
    else
        echo "  ⚠️  DB size: ${size_mb}MB (>50MB). Run compact + prune."
        fail=1
    fi

    # 7. Backup freshness (within 2 days)
    local latest_backup
    latest_backup=$(find "$(dirname "$DB")" -maxdepth 1 -name 'amp-mem.db.backup-*' -mtime -2 2>/dev/null | head -1)
    if [ -n "$latest_backup" ]; then
        echo "  ✅ Recent backup: $(basename "$latest_backup")"
    else
        echo "  ⚠️  No backup in last 2 days. Run: amp-mem backup"
        fail=1
    fi

    echo ""
    if [ "$fail" -eq 0 ]; then
        echo "  ✅ All checks passed"
    else
        echo "  ⚠️  Some checks need attention"
    fi
    return $fail
}

# ── Main dispatch ────────────────────────────────────────────────────────

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    init)           cmd_init ;;
    save)           cmd_save "$@" ;;
    search)         cmd_search "$@" ;;
    timeline)       cmd_timeline "$@" ;;
    detail)         cmd_detail "$@" ;;
    context)        cmd_context "$@" ;;
    compact)        cmd_compact "$@" ;;
    compact-status) cmd_compact_status ;;
    prune)          cmd_prune "$@" ;;
    session-start)  cmd_session_start "$@" ;;
    session-end)    cmd_session_end "$@" ;;
    stats)          cmd_stats ;;
    export)         cmd_export "$@" ;;
    serve)          cmd_serve "$@" ;;
    migrate)        cmd_migrate ;;
    ingest-thread)  cmd_ingest_thread "$@" ;;
    distill-dump)   cmd_distill_dump "$@" ;;
    distill-record) cmd_distill_record "$@" ;;
    distill-status) cmd_distill_status ;;
    decay)          cmd_decay ;;
    backup)         cmd_backup "$@" ;;
    doctor)         cmd_doctor ;;
    help|--help|-h)
        echo "amp-mem — Persistent cross-session memory for Amp"
        echo ""
        echo "Commands:"
        echo "  init                          Initialize database"
        echo "  save <type> <topic> <summary> Save an observation"
        echo "       [--project P] [--file F] [--tags T] [--session S] [--private]"
        echo "  search <query>                FTS5 search (compact index)"
        echo "       [--type T] [--project P] [--after D] [--before D] [--limit N] [--include-private]"
        echo "  timeline <id> [--window N]    Context around an observation"
        echo "  detail <id> [<id2> ...]       Full observation details"
        echo "  context [--lines N]           Recent context for session priming"
        echo "  compact [--older-than DAYS]   Compress old entries into weekly summaries"
        echo "  compact-status                Health check for the compact pipeline"
        echo "  prune [--older-than DAYS] [--commit]  Delete raw obs older than N days"
        echo "       (default 90, dry-run unless --commit; only deletes obs already"
        echo "        marked compacted_at, so every deleted row is in a summary)"
        echo "  session-start [--thread-url]  Start a new session"
        echo "  session-end [--session ID]    End a session"
        echo "  stats                         Memory statistics"
        echo "  export [--format md|json] [--include-private]  Export memory (private excluded by default)"
        echo "  serve [--port PORT]           Start web viewer (default: 37777)"
        echo "  migrate                       Import sessions.jsonl into SQLite"
        echo "  ingest-thread <id> <title> <summary>  Ingest an Amp thread (de-duped)"
        echo "       [--date D] [--url U] [--tags T]"
        echo "  distill-dump [--since DATE]   Dump observations for distillation"
        echo "  distill-record <n> <notes> <rules> [summary]  Record distillation run"
        echo "  distill-status                Last distillation info"
        echo "  backup [--force] [--tag NAME] WAL-safe backup (daily-idempotent; --force = fresh timestamped)"
        echo "  doctor                        Health checks (pending, FTS, types, sessions, size, backups)"
        echo "  decay                         (deprecated — decay is read-time only)"
        ;;
    *)
        echo "❌ Unknown command: $cmd" >&2
        echo "   Run 'amp-mem help' for usage." >&2
        exit 1
        ;;
esac

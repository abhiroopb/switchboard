{
  "about": "Shared cases for the Slack link rule (rule 13, slack-link-format). system/scripts/test_slack_format.py runs them against slack_format.py and system/amp-plugins/pm-os/slack-link-format.test.ts against pm-os-guardrails.ts, so the two detectors stay aligned. The blocks cases pin that a labelled rich_text link in a --blocks file is not judged as a bare URL. Every URL here is invented.",
  "text": [
    {"name": "inline anchor", "text": "See <https://example.com/doc|the plan doc> for detail.", "bare_urls": []},
    {"name": "bare url", "text": "See https://example.com/doc for detail.", "bare_urls": ["https://example.com/doc"]},
    {"name": "url inside a code span", "text": "Run `curl https://example.com/api` once.", "bare_urls": []}
  ],
  "blocks": [
    {
      "name": "labelled rich_text link",
      "blocks": [{"type": "rich_text", "elements": [{"type": "rich_text_section", "elements": [
        {"type": "text", "text": "Notes are in "},
        {"type": "link", "url": "https://example.com/notes", "text": "the review note"},
        {"type": "text", "text": "."}
      ]}]}],
      "bare_urls": []
    },
    {
      "name": "unlabelled rich_text link",
      "blocks": [{"type": "rich_text", "elements": [{"type": "rich_text_section", "elements": [
        {"type": "text", "text": "Notes: "},
        {"type": "link", "url": "https://example.com/notes"}
      ]}]}],
      "bare_urls": ["https://example.com/notes"]
    },
    {
      "name": "blank label counts as unlabelled",
      "blocks": [{"type": "rich_text", "elements": [{"type": "rich_text_section", "elements": [
        {"type": "link", "url": "https://example.com/blank", "text": "  "}
      ]}]}],
      "bare_urls": ["https://example.com/blank"]
    },
    {
      "name": "bare url in a mrkdwn section",
      "blocks": [{"type": "section", "text": {"type": "mrkdwn", "text": "Status: https://example.com/status"}}],
      "bare_urls": ["https://example.com/status"]
    },
    {
      "name": "mrkdwn anchor in a section",
      "blocks": [{"type": "section", "text": {"type": "mrkdwn", "text": "Status: <https://example.com/status|status page>"}}],
      "bare_urls": []
    }
  ]
}
